# Database connection string
# Get this from your Neon PostgreSQL dashboard or other PostgreSQL provider
DATABASE_URL=postgresql://user:password@localhost:5432/tweeter

# Environment
NODE_ENV=development

# JWT secret for authentication
# Generate a strong random string for production
JWT_SECRET=your_super_secret_jwt_key_here

# Port for the API server
PORT=3000

# Application URL (used for email verification links)
# Update this to your production domain when deploying
APP_URL=http://localhost:5173

# Cloudinary Configuration (for image uploads)
# Sign up at https://cloudinary.com and get these from your dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Mailgun Configuration (for email verification)
# Sign up at https://mailgun.com and get these from your dashboard
MAILGUN_DOMAIN=your_mailgun_domain
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_API_URL=https://api.mailgun.net

# Optional: OpenAI API Configuration (if using AI features)
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo