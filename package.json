{
  "name": "tweeter",
  "version": "1.0.0",
  "description": "A nostalgic clone of Twitter back when tweets were limited to 140 characters, built with modern web technologies.",
  "main": "index.js",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "seed:reset": "tsx scripts/seed.ts reset",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MartyBonacci/Tweeter.git"
